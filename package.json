{
  "name": "shopify-token-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Generate a Shopify Admin API access token via OAuth. React + Vite + Tailwind UI with a tiny Express backend for the secure token exchange.",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"green,cyan\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
